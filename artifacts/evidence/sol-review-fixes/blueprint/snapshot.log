      {
        "id": "factorization",
        "kind": "theorem",
        "title": "Monotone-light factorization",
        "statement": "Every continuous f from compact Hausdorff X to Hausdorff Y factors through\nthe component quotient as a surjective monotone quotient q and continuous light l.",
        "informal_proof": "f is constant on q-fibres, so the quotient lifting theorem supplies a continuous\nl with f = l composed with q. If C is a connected subset of an l-fibre, its\npreimage under the closed monotone q is connected. That preimage lies in one\nf-fibre, hence in one component, and therefore C contains at most one point.\nThis proves lightness.",
        "goal": null,
        "uses": [
          "partition",
          "compact-middle",
          "middle-space"
        ],
        "isabelle": {
          "fact": "Monotone_Light.monotone_light_factorization",
          "theory": "Monotone_Light",
          "session": null
        },
        "status": {
