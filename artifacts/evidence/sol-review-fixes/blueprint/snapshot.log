      {
        "id": "closed-projection",
        "kind": "theorem",
        "title": "The component projection is closed",
        "statement": "For compact Hausdorff X, Hausdorff Y and continuous f, q is closed.",
        "informal_proof": "For a closed A and x outside its saturation, separate q(x) from A inside the\ncompact fibre using equality of components and quasicomponents. Extend the\nclopen partition of that fibre to disjoint open sets in X, one avoiding A.\nSince f is closed, a neighbourhood of f(x) has its whole preimage inside their\nunion. Connected fibre components cannot cross this union. This yields an open\nneighbourhood of x avoiding the saturation of A. Thus the saturation is closed,\nand the quotient criterion makes q(A) closed.",
        "goal": null,
        "uses": [
          "partition"
        ],
        "isabelle": {
          "fact": "Monotone_Light.component_quotient_closed",
          "theory": "Monotone_Light",
          "session": null
        },
        "status": {
          "blueprint": "written",
          "formal": "proved",
          "agent": "solved",
          "last_checked": "2026-10-11T20:40:22.984462+00:00",
          "check_error": null
